# URL base de OpenText Content Management (sin barra final)
OTCS_URL=https://otcs.mydomain.com/cs/cs

# Credenciales usadas en la llamada de autenticación POST /api/v1/auth
OTCS_USERNAME=
OTCS_PASSWORD=
# OTCS_DOMAIN es opcional; solo es necesario si el servidor tiene habilitado
# el soporte multi-dominio
OTCS_DOMAIN=

# ID de la categoría "Raw material" (consultar en Admin > Category o via
# GET /api/v2/nodes/{id}/categories sobre un documento ya categorizado)
OTCS_CATEGORY_ID=426619

# ID del atributo "Name" dentro de la categoría anterior (el sufijo "_1" está
# reservado a la propia categoría; los atributos de datos empiezan en "_2")
OTCS_ATTR_NAME_ID=426619_2

# ID del atributo "Ticker" dentro de la categoría anterior
OTCS_ATTR_TICKER_ID=426619_3

# Opcional: IDs de clasificación (roles.classifications.create_id) que el
# formulario web asigna junto con la categoría. Lista separada por comas.
OTCS_CLASSIFICATION_IDS=426621
